#!/bin/bash 

#SBATCH -J Resample
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=2G
#SBATCH --time=00:20:00
#SBATCH --account=p274
#SBATCH --output logs-03/slurm-%j.txt


module purge
loadR() {
echo "loading R"
module load R/4.2.1-foss-2022a
#R aliases
export R_LIBS_SITE=/cluster/projects/p274/tools/r/r_libs/$(R --version | grep "R version" | awk '{print $3}')
if [ ! -d $R_LIBS_SITE ]; then
mkdir -p $R_LIBS_SITE
fi
export R_LIBS_USER=$HOME/R/x86_64-redhat-linux-gnu-library/$(R --version | grep "R version" | awk '{print $3}')
if [ ! -d $R_LIBS_USER ]; then
mkdir -p $R_LIBS_USER
fi
}
loadR

#module load R/4.0.0-foss-2020a
echo `which R`
set -o errexit


echo $1 $2 $3 $4 $5 $6

start=${1}
end=${2}
yearsBeforeAB=${3}
analysname=${4}
metric=${5}
nTime=${6}

echo "Submitting split number: ${start}-${end}"

#RUN resampled cortical map
Rscript 03-cortmaps_resample_nTime.R $start $end $yearsBeforeAB $analysname $metric $nTime
